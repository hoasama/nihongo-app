{
  "name": "japanese-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:127.0.0.1:1420 && cross-env VITE_DEV=1 electron electron/main.cjs",
    "dev": "concurrently -k -n vite,electron \"npm:dev:vite\" \"npm:dev:electron\"",
    "build": "vue-tsc --noEmit && vite build",
    "start": "npm run build && electron electron/main.cjs",
    "preview": "vite preview",
    "test": "cross-env NODE_OPTIONS=--experimental-sqlite vitest run",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-sqlite vitest",
    "build:seed": "cross-env NODE_OPTIONS=--experimental-sqlite tsx scripts/build-seed/src/buildSeed.ts"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.10",
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "better-sqlite3": "^13.1.1",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.2",
    "fast-xml-parser": "^5.12.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14",
    "wait-on": "^9.5.1",
    "wanakana": "^5.3.1"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.107.1",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1"
  }
}
